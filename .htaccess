# ============================================================
# REDIRECT HTTP KE HTTPS
# ============================================================
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================================
# DIRECTORY INDEX (file yang dimuat saat akses root)
# ============================================================
DirectoryIndex index.html

# ============================================================
# REDIRECT URL LAMA KE URL BARU (SETELAH PINDAH FOLDER)
# ============================================================

# Beranda
Redirect 301 /index.html https://agungperkasaborepile.com/
Redirect 301 /beranda.html https://agungperkasaborepile.com/

# JASA
Redirect 301 /bore-pile-jakarta.html https://agungperkasaborepile.com/jasa/bore-pile-jakarta.html
Redirect 301 /bore-pile-bekasi.html https://agungperkasaborepile.com/jasa/bore-pile-bekasi.html
Redirect 301 /bore-pile-tangerang.html https://agungperkasaborepile.com/jasa/bore-pile-tangerang.html
Redirect 301 /bore-pile-depok.html https://agungperkasaborepile.com/jasa/bore-pile-depok.html
Redirect 301 /bore-pile-bogor.html https://agungperkasaborepile.com/jasa/bore-pile-bogor.html
Redirect 301 /bore-pile-cibubur.html https://agungperkasaborepile.com/jasa/bore-pile-cibubur.html
Redirect 301 /bore-pile-cikarang.html https://agungperkasaborepile.com/jasa/bore-pile-cikarang.html
Redirect 301 /bore-pile-bsd.html https://agungperkasaborepile.com/jasa/bore-pile-bsd.html
Redirect 301 /bore-pile-bintaro.html https://agungperkasaborepile.com/jasa/bore-pile-bintaro.html
Redirect 301 /bore-pile-ciputat.html https://agungperkasaborepile.com/jasa/bore-pile-ciputat.html
Redirect 301 /bore-pile-pamulang.html https://agungperkasaborepile.com/jasa/bore-pile-pamulang.html
Redirect 301 /bore-pile-karawaci.html https://agungperkasaborepile.com/jasa/bore-pile-karawaci.html
Redirect 301 /bore-pile-murah.html https://agungperkasaborepile.com/jasa/bore-pile-murah.html

# HARGA
Redirect 301 /harga-bore-pile-2026.html https://agungperkasaborepile.com/harga/bore-pile-2026.html
Redirect 301 /harga-bore-pile-30cm.html https://agungperkasaborepile.com/harga/bore-pile-30cm.html
Redirect 301 /harga-bore-pile-40cm.html https://agungperkasaborepile.com/harga/bore-pile-40cm.html
Redirect 301 /harga-bore-pile-50cm.html https://agungperkasaborepile.com/harga/bore-pile-50cm.html

# ARTIKEL
Redirect 301 /artikel.html https://agungperkasaborepile.com/artikel/index.html
Redirect 301 /bore-pile-vs-strauss.html https://agungperkasaborepile.com/artikel/bore-pile-vs-strauss-pile.html
Redirect 301 /borepile-vs-tiang-pancang.html https://agungperkasaborepile.com/artikel/borepile-vs-tiang-pancang.html
Redirect 301 /proses-bore-pile.html https://agungperkasaborepile.com/artikel/proses-bore-pile.html

# GALERI
Redirect 301 /gallery.html https://agungperkasaborepile.com/galeri/gallery.html

# ============================================================
# GZIP KOMPRESI - BIKIN FILE LEBIH KECIL (SPEED)
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json text/xml application/xml application/rss+xml
</IfModule>

# ============================================================
# CACHE - BIAR BROWSER NYIMPAN FILE (SPEED)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSS & JS - cache 1 tahun
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Gambar - cache 1 tahun
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Font - cache 1 tahun
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # HTML - cache 1 hari
    ExpiresByType text/html "access plus 1 day"
</IfModule>

# ============================================================
# HEADER CACHE (ALTERNATIF/EXTRA)
# ============================================================
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|svg|jpg|jpeg|png|gif|ico|css|js|woff2|woff)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>